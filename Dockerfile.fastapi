###################################################
# Stage: base
#
# Node base used only for the client stages. Mirrors the `base` stage of the
# original Dockerfile so the client build is byte-for-byte the same.
###################################################
FROM node:22 AS base
WORKDIR /usr/local/app

################## CLIENT STAGES ##################

###################################################
# Stage: client-base
#
# Common steps for the client-dev and client-build stages. Unchanged from the
# original Dockerfile.
###################################################
FROM base AS client-base
COPY client/package.json client/package-lock.json ./
COPY .npmrc .
RUN npm ci
COPY client/.eslintrc.cjs client/index.html client/vite.config.js ./
COPY client/public ./public
COPY client/src ./src

###################################################
# Stage: client-dev
#
# Development server for the client application.
###################################################
FROM client-base AS client-dev
CMD ["npm", "run", "dev"]

###################################################
# Stage: client-build
#
# Builds the client with Vite, producing the static HTML, CSS, and JS in
# /usr/local/app/dist that the backend serves.
###################################################
FROM client-base AS client-build
RUN npm run build




###################################################
################  BACKEND STAGES  #################
###################################################

###################################################
# Stage: final
#
# The production image for the FastAPI backend. It installs the Python
# dependencies, copies the application code, and copies the client bundle from
# the client-build stage into the directory that FastAPI's StaticFiles mount
# serves at "/" (the equivalent of express.static() in the Node version).
###################################################
FROM python:3.12-slim AS final
WORKDIR /usr/local/app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

COPY backend-fastapi/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY backend-fastapi/main.py backend-fastapi/schemas.py ./
COPY backend-fastapi/routes ./routes
COPY backend-fastapi/persistence ./persistence

# Copied last so the freshly built bundle wins over anything checked into
# backend-fastapi/static (which is deliberately not copied above).
COPY --from=client-build /usr/local/app/dist ./static

EXPOSE 3000
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "3000"]
